# Copy this file to .env and fill in real values before running the bridge.
# .env is read by dotenv (see sync.js) and should NEVER be committed anywhere
# public — it holds this school's biometric API key.

# The biometric device's IP address ON THE SCHOOL'S OWN NETWORK (not a public
# address) — check the device's own menu (usually Menu > Comm > Ethernet) or
# ask whoever installed it. Example: 192.168.1.201
DEVICE_IP=

# The device's TCP port for its SDK protocol. 4370 is the near-universal
# default for ZKTeco-protocol devices (which is most budget/mid-range
# fingerprint attendance machines sold in India, including many sold under
# the eSSL, Realtime, and Mantra brand names) — only change this if the
# device's own settings show something else.
DEVICE_PORT=4370

# A short label for this device, sent with every punch so the ERP's
# Biometric Sync log shows which physical device it came from. Any string —
# e.g. the device's serial number (Menu > System Info) or just "MainGate".
DEVICE_SERIAL=

# This school's own ERP URL (the Render URL for their server.js deploy) and
# the same BIOMETRIC_API_KEY value you set as an environment variable on
# that Render service. These two must match exactly, or every push will be
# rejected with 401.
ERP_URL=https://REPLACE-WITH-THIS-SCHOOLS-ERP.onrender.com
BIOMETRIC_API_KEY=

# How often to poll the device for new punches, in minutes, when run via
# `npm start` (continuous mode). Ignored when run with --once (e.g. from a
# scheduled task). 5 is a reasonable default — attendance doesn't need to
# be real-time, and this keeps load on the device low.
POLL_INTERVAL_MINUTES=5
